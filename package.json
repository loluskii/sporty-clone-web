    "format": "prettier --write src/"
  },
  "dependencies": {
    "@vuepic/vue-datepicker": "^8.2.0",
    "crypto-js": "^4.2.0",
    "jquery": "^3.7.1",
    "js-cookie": "^3.0.5",
    "lodash": "^4.17.21",
    "mitt": "^3.0.1",
    "moment": "^2.30.1",
    "mqtt": "^5.13.0",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "vue": "^3.4.15",
    "vue-query": "^1.26.0",
    "vue-router": "^4.2.5",
    "vue3-otp-input": "^0.4.4"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/test-utils": "^2.4.4",
    "cypress": "^13.6.3",
    "eslint": "^8.49.0",
